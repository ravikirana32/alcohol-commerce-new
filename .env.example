NODE_ENV=development
API_PORT=8080
WEB_PORT=5173
DATABASE_URL=postgresql://acp:acp_local_dev_only@localhost:5432/acp
REDIS_URL=redis://localhost:6379
VITE_API_BASE_URL=http://localhost:8080
# Generate a unique random value for each environment. Never use the example in production.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h
# Used only for one-time initial platform admin bootstrap. Rotate/remove after setup.
BOOTSTRAP_SECRET=replace-with-a-long-one-time-secret
WEB_ORIGIN=http://localhost:5173

# AI remains disabled until separately approved and configured.
AI_FEATURES_ENABLED=false
OFFLINE_SYNC_ENABLED=false

CONSUMER_DISCOVERY_ENABLED=false
SECURE_COOKIE_AUTH=false
PAYMENT_LIVE_MODE=false
NOTIFICATIONS_LIVE_MODE=false
# Optional Razorpay test-mode credentials. Never commit actual credentials.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# PAYMENT_WEBHOOK_SECRET_RAZORPAY=...
# Local demo role accounts. Keep disabled by default; never enable in production.
# Set these only in your untracked local .env file before running db:seed:demo.
DEMO_SEED_ENABLED=false
# DEMO_SEED_PASSWORD=choose-a-unique-local-password-at-least-14-chars
